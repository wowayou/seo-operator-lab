{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seo-operator-lab.local/schemas/quest.schema.json",
  "title": "SEO Operator Lab Quest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "sequence",
    "platform",
    "title",
    "description",
    "difficulty",
    "skills",
    "environment",
    "objective",
    "target",
    "editor",
    "hints",
    "walkthrough",
    "searchQuery",
    "success",
    "postPassReview",
    "review",
    "scoring"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^wp-[a-z0-9-]+-[0-9]{3}$" },
    "phase": { "const": "B" },
    "sequence": { "type": "integer", "minimum": 1 },
    "platform": { "const": "wordpress" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 20 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wordpress", "php"],
      "properties": {
        "wordpress": { "type": "string" },
        "php": { "type": "string" }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "completion"],
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "completion": { "type": "string", "minLength": 10 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^/[^?#]*/$" }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "label", "location"],
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+\\.php$" },
        "label": { "type": "string", "minLength": 3 },
        "location": { "type": "string", "minLength": 3 }
      }
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/hint" }
    },
    "walkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "steps", "before", "after", "caution"],
      "properties": {
        "concept": { "type": "string", "minLength": 15 },
        "steps": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 10 } },
        "before": { "type": "string", "minLength": 10 },
        "after": { "type": "string", "minLength": 10 },
        "caution": { "type": "string", "minLength": 15 }
      }
    },
    "searchQuery": { "type": "string", "minLength": 8 },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "message"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "message": { "type": "string", "minLength": 8 }
      }
    },
    "postPassReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "notes"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        },
        "advancedChallenge": { "$ref": "#/definitions/advancedChallenge" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalsDays"],
      "properties": {
        "intervalsDays": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "hintPenalty", "solutionPenalty"],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "hintPenalty": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "integer", "minimum": 0 }
        },
        "solutionPenalty": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title", "text"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "title": { "type": "string", "minLength": 3 },
        "text": { "type": "string", "minLength": 15 },
        "href": { "type": "string", "pattern": "^https://" },
        "linkLabel": { "type": "string", "minLength": 3 },
        "action": { "enum": ["open-editor"] }
      },
      "dependencies": {
        "href": ["linkLabel"],
        "linkLabel": ["href"]
      }
    },
    "advancedChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "instruction", "editorFile", "buttonLabel"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 15 },
        "why": { "type": "string", "minLength": 10 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 8 }
        },
        "instruction": { "type": "string", "minLength": 15 },
        "editorFile": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+\\.php$" },
        "buttonLabel": { "type": "string", "minLength": 3 }
      }
    }
  }
}
